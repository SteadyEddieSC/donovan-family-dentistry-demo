# Optional production services. Leave blank for the current private demo behavior.
# Public values are embedded into the static build; never put secret keys here.

# Basin HTML form endpoint, for example: https://usebasin.com/f/xxxxxxxxxxxx
PUBLIC_BASIN_FORM_ENDPOINT=

# Public Cloudflare Turnstile site key. Configure the matching secret in Basin,
# then enable "Require valid Turnstile response" in the Basin form settings.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics site token from the dashboard beacon snippet.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
