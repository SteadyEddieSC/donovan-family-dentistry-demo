# Optional production services. Leave blank or false for the current private demo behavior.
# PUBLIC_ values are embedded into the static build; never put secret keys here.

# The contact page remains a local-only preview unless this is explicitly true.
PUBLIC_ADMIN_INQUIRY_ENABLED=false

# Public Cloudflare Turnstile site key. The matching secret belongs in the
# Cloudflare Pages runtime secrets, never in a PUBLIC_ variable.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics site token from the dashboard beacon snippet.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Runtime-only names are documented in .dev.vars.example and
# docs/release-13-administrative-inquiry.md. Configure them as encrypted
# Cloudflare Pages variables/secrets rather than static build variables.
