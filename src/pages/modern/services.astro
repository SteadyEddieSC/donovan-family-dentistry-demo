---
import ModernLayout from '../../layouts/ModernLayout.astro';
const groups = [
  {
    id: 'restore',
    title: 'Restorative care',
    copy: 'Repair damaged teeth and restore function with materials and treatment options selected for the individual situation.',
    services: ['Esthetic tooth-colored restorations', 'Durable silver restorations', 'Dental implants', 'Ceramic veneers, crowns and bridges'],
    planning: 'A clinical examination helps determine whether a filling, crown, bridge, implant, or another approach is appropriate.'
  },
  {
    id: 'smile',
    title: 'Smile and tooth replacement',
    copy: 'Explore options intended to improve appearance, replace missing teeth, and support confidence in your smile.',
    services: ['Smile makeovers', 'Bleaching / teeth whitening', 'Dentures and partials', 'Flexible, metal-free partials'],
    planning: 'Bring questions about appearance, comfort, maintenance, timing, and how each option may fit your goals.'
  },
  {
    id: 'advanced',
    title: 'Advanced care',
    copy: 'Address pain, infection, gum concerns, and teeth that cannot be predictably restored.',
    services: ['Root canal therapy', 'Extractions', 'Management of gum disease', 'Minor gum surgeries'],
    planning: 'Symptoms and urgency vary. Call the office so the team can explain the appropriate scheduling process.'
  }
];
---
<ModernLayout title="Dental Services | Donovan Family Dentistry" description="Explore the published dental services offered by Donovan Family Dentistry in Beaufort, South Carolina.">
  <section class="modern-page-hero">
    <div class="modern-shell modern-page-hero__grid">
      <div><p class="modern-kicker">Services</p><h1>Comprehensive care, easier to understand.</h1></div>
      <div class="modern-page-hero__aside">
        <p>This is the detailed services page. The homepage now provides only brief care paths so the complete list is not repeated in two places.</p>
        <nav class="modern-service-jump" aria-label="Service categories">
          {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
        </nav>
      </div>
    </div>
  </section>

  <section class="modern-section">
    <div class="modern-shell">
      <div class="modern-service-grid">
        {groups.map((group,index) => (
          <article class="modern-service-card" data-number={`0${index+1}`} id={group.id}>
            <h3>{group.title}</h3>
            <p>{group.copy}</p>
            <ul>{group.services.map((service) => <li>{service}</li>)}</ul>
            <p><strong>Planning note:</strong> {group.planning}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="modern-section modern-section--sea">
    <div class="modern-shell">
      <div class="modern-section__head">
        <p class="modern-eyebrow">Planning care</p>
        <h2>Questions are part of the process.</h2>
        <p>The website can explain categories and help patients prepare, but a dentist must evaluate the individual situation before recommending treatment.</p>
      </div>
      <div class="modern-card-grid">
        <article class="modern-card"><h3>Start by calling</h3><p>Contact the office for availability and general scheduling questions.</p><a href="tel:+18435256866">Call (843) 525-6866</a></article>
        <article class="modern-card"><h3>Prepare your forms</h3><p>Complete the fillable medical-history form and bring it to the visit.</p><a href="/modern/forms/">Open patient forms</a></article>
        <article class="modern-card"><h3>Know who you may meet</h3><p>Provider biographies and staff roles are together on the Team page.</p><a href="/modern/team/">Meet the team</a></article>
      </div>
    </div>
  </section>
</ModernLayout>
