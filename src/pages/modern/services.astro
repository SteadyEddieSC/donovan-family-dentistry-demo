---
import ModernLayout from '../../layouts/ModernLayout.astro';
import practiceContent from '../../data/practice-content.json';
import services from '../../data/services.json';
import site from '../../data/site.json';

const pageContent = practiceContent.servicesPage;
const visibleServices = services.filter((service) => service.visible).sort((a, b) => a.order - b.order);
const groups = pageContent.groups
  .map((group) => ({
    ...group,
    services: visibleServices.filter((service) => service.groupId === group.id)
  }))
  .filter((group) => group.services.length > 0)
  .sort((a, b) => a.order - b.order);
---
<ModernLayout title="Dental Services | Donovan Family Dentistry" description="Explore the published dental services offered by Donovan Family Dentistry in Beaufort, South Carolina.">
  <section class="modern-page-hero">
    <div class="modern-shell modern-page-hero__grid">
      <div><p class="modern-kicker">{pageContent.kicker}</p><h1>{pageContent.headline}</h1></div>
      <div class="modern-page-hero__aside">
        <p>{pageContent.introduction}</p>
        <nav class="modern-service-jump" aria-label="Service categories">
          {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
        </nav>
      </div>
    </div>
  </section>

  <section class="modern-section">
    <div class="modern-shell">
      <div class="modern-service-grid">
        {groups.map((group, index) => (
          <article class="modern-service-card" data-number={`0${index + 1}`} id={group.id}>
            <h2>{group.title}</h2>
            <p>{group.summary}</p>
            <ul>{group.services.map((service) => <li>{service.name}</li>)}</ul>
            <p><strong>Planning note:</strong> {group.planning}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="modern-section modern-section--sea">
    <div class="modern-shell">
      <div class="modern-section__head">
        <p class="modern-eyebrow">{pageContent.planningEyebrow}</p>
        <h2>{pageContent.planningTitle}</h2>
        <p>{pageContent.planningText}</p>
      </div>
      <div class="modern-card-grid">
        <article class="modern-card"><h3>Start by calling</h3><p>Contact the office for availability and general scheduling questions.</p><a href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay}</a></article>
        <article class="modern-card"><h3>Prepare your forms</h3><p>Complete the fillable medical-history form and bring it to the visit.</p><a href="/modern/forms/">Open patient forms</a></article>
        <article class="modern-card"><h3>Know who you may meet</h3><p>Provider information and staff roles are together on the Team page.</p><a href="/modern/team/">Meet the team</a></article>
      </div>
    </div>
  </section>
</ModernLayout>
