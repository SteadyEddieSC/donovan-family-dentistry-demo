---
import ModernLayout from '../../layouts/ModernLayout.astro';
import ModernPortrait from '../../components/ModernPortrait.astro';
import site from '../../data/site.json';
import teamData from '../../data/modern-team.json';

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.postalCode}`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const serviceGroups = [
  { title: 'Restore & renew', services: ['Tooth-colored fillings', 'Durable silver restorations', 'Dental implants', 'Ceramic veneers, crowns and bridges'] },
  { title: 'Smile & confidence', services: ['Smile makeovers', 'Teeth whitening', 'Dentures and partials', 'Flexible metal-free partials'] },
  { title: 'Advanced & ongoing care', services: ['Root canal therapy', 'Extractions', 'Management of gum disease', 'Minor gum surgeries'] }
];
const featuredTeam = teamData.team.slice(0, 3);
---
<ModernLayout>
  <section class="modern-hero">
    <div class="modern-shell modern-hero__grid">
      <div>
        <p class="modern-kicker">Lady's Island · Beaufort, South Carolina</p>
        <h1>Your Lowcountry smile, cared for <em>close to home.</em></h1>
        <p class="modern-lead">Comprehensive dental care for patients of all ages, delivered by a welcoming local team at 91 Sams Point Road.</p>
        <div class="modern-actions">
          <a class="modern-button modern-button--primary" href={`tel:${site.phoneHref}`}>Call the office</a>
          <a class="modern-button modern-button--secondary" href="/modern/contact/">Request a call</a>
          <a class="modern-button modern-button--secondary" href="/modern/forms/">Patient forms</a>
        </div>
      </div>
      <div class="modern-hero__visual">
        <img src={site.heroImage} width="900" height="675" alt={site.heroAlt} fetchpriority="high" />
        <div class="modern-location-card">
          <strong>At home in the Lowcountry</strong>
          <span>On Lady's Island, minutes from downtown Beaufort.</span>
        </div>
      </div>
    </div>
  </section>

  <div class="modern-quickfacts">
    <div class="modern-shell modern-quickfacts__grid">
      <div class="modern-fact"><small>Office hours</small><strong>Monday-Thursday, 7:30-5</strong></div>
      <div class="modern-fact"><small>Call</small><strong>{site.phoneDisplay}</strong></div>
      <div class="modern-fact"><small>Visit</small><strong>91 Sams Point Road</strong></div>
    </div>
  </div>

  <section class="modern-section" aria-labelledby="home-care-heading">
    <div class="modern-shell">
      <div class="modern-section__head">
        <p class="modern-eyebrow">Comprehensive care</p>
        <h2 id="home-care-heading">Dental services organized around your needs.</h2>
        <p>Explore the practice's published procedures in clear, patient-friendly groups.</p>
      </div>
      <div class="modern-service-grid">
        {serviceGroups.map((group, index) => (
          <article class="modern-service-card" data-number={`0${index + 1}`}>
            <h3>{group.title}</h3>
            <ul>{group.services.map((service) => <li>{service}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="modern-actions"><a class="modern-button modern-button--primary" href="/modern/services/">View all services</a></div>
    </div>
  </section>

  <section class="modern-section modern-section--sea" aria-labelledby="home-doctors-heading">
    <div class="modern-shell">
      <div class="modern-section__head">
        <p class="modern-eyebrow">Meet the dentists</p>
        <h2 id="home-doctors-heading">Experience, clear explanations, and a comfortable approach.</h2>
      </div>
      <div class="modern-doctor">
        <div class="modern-doctor__photo"><img src={teamData.providers[0].image} width="900" height="720" alt={teamData.providers[0].imageAlt} /></div>
        <div>
          <p class="modern-eyebrow">{teamData.providers[0].role}</p>
          <h2>{teamData.providers[0].name}, {teamData.providers[0].credentials}</h2>
          <p>{teamData.providers[0].summary}</p>
          <div class="modern-doctor__highlights">{teamData.providers[0].highlights.map((item) => <span class="modern-chip">{item}</span>)}</div>
          <a class="modern-button modern-button--primary" href="/modern/about/">Meet the dentists</a>
        </div>
      </div>
      <div class="modern-doctor modern-doctor--reverse">
        <div class="modern-doctor__photo"><ModernPortrait name={teamData.providers[1].name} variant={teamData.providers[1].portrait} /></div>
        <div>
          <p class="modern-eyebrow">{teamData.providers[1].role}</p>
          <h2>{teamData.providers[1].name}, {teamData.providers[1].credentials}</h2>
          <p>{teamData.providers[1].summary}</p>
          <div class="modern-doctor__highlights">{teamData.providers[1].highlights.map((item) => <span class="modern-chip">{item}</span>)}</div>
          <a class="modern-button modern-button--primary" href="/modern/about/">Read the profile</a>
        </div>
      </div>
    </div>
  </section>

  <section class="modern-section modern-section--deep" aria-labelledby="home-team-heading">
    <div class="modern-shell">
      <div class="modern-section__head">
        <p class="modern-eyebrow">The people patients meet</p>
        <h2 id="home-team-heading">A full team focused on a smooth visit.</h2>
        <p>From the first phone call through treatment and follow-up, patients should know who is here to help.</p>
      </div>
      <div class="modern-team-grid">
        {featuredTeam.map((member) => (
          <article class="modern-team-card">
            <ModernPortrait name={member.name} variant={member.portrait} />
            <div class="modern-team-card__body">
              <h3>{member.name}</h3>
              <span class="modern-team-card__role">{member.role}</span>
              <p>{member.bio}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="modern-actions"><a class="modern-button modern-button--coral" href="/modern/team/">Meet the whole team</a></div>
    </div>
  </section>

  <section class="modern-section modern-section--sand" aria-labelledby="home-visit-heading">
    <div class="modern-shell modern-visit-grid">
      <article class="modern-visit-card">
        <p class="modern-eyebrow">New patients</p>
        <h2 id="home-visit-heading">A simple path from screen to chair.</h2>
        <ol class="modern-checklist">
          <li><strong>Call the office.</strong><br />Confirm appointment availability and ask general scheduling questions.</li>
          <li><strong>Complete the forms.</strong><br />Use the fillable medical-history form and review the privacy notice.</li>
          <li><strong>Bring the paperwork.</strong><br />Print completed forms and bring them to the office unless a secure delivery method is provided.</li>
        </ol>
        <div class="modern-actions"><a class="modern-button modern-button--primary" href="/modern/forms/">Open patient forms</a><a class="modern-button modern-button--secondary" href={mapHref} rel="noopener">Get directions</a></div>
      </article>
      <aside class="modern-visit-card">
        <h3>Office hours</h3>
        <table class="modern-hours"><tbody>{site.hours.map((item) => <tr><th scope="row">{item.day}</th><td>{item.hours}</td></tr>)}</tbody></table>
      </aside>
    </div>
  </section>

  <section class="modern-section" aria-labelledby="home-faq-heading">
    <div class="modern-shell">
      <div class="modern-section__head"><p class="modern-eyebrow">Helpful answers</p><h2 id="home-faq-heading">Before you visit.</h2></div>
      <div class="modern-faq-grid">
        <details class="modern-faq" open><summary>Where is the office?</summary><p>Donovan Family Dentistry is located at 91 Sams Point Road on Lady's Island in Beaufort, South Carolina.</p></details>
        <details class="modern-faq"><summary>Can I complete forms electronically?</summary><p>Yes. The medical-history form is fillable on many devices. Save it locally, then print and bring it to the office.</p></details>
        <details class="modern-faq"><summary>Can I send medical details through the website?</summary><p>No. General website inquiries should not include symptoms, diagnoses, medications, insurance identifiers, or other protected health information.</p></details>
      </div>
    </div>
  </section>
</ModernLayout>
