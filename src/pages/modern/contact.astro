---
import ModernLayout from '../../layouts/ModernLayout.astro';
import site from '../../data/site.json';
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.postalCode}`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---
<ModernLayout title="Contact & Directions | Donovan Family Dentistry" description="Call Donovan Family Dentistry, get directions to 91 Sams Point Road, or preview a general administrative inquiry.">
  <section class="modern-page-hero"><div class="modern-shell modern-page-hero__grid"><div><p class="modern-kicker">Contact & directions</p><h1>Get in touch with the office.</h1></div><p class="modern-page-hero__aside">Call for the fastest response, open directions to Lady's Island, or preview a general administrative inquiry without entering health information.</p></div></section>
  <section class="modern-section modern-section--deep"><div class="modern-shell modern-connect-grid"><div><p class="modern-eyebrow">Visit or call</p><h2>Clear next steps.</h2><p class="modern-lead">The practice is located at 91 Sams Point Road on Lady's Island in Beaufort.</p><div class="modern-contact-stack"><a class="modern-contact-tile" href={`tel:${site.phoneHref}`}><span><strong>Call the office</strong><span>{site.phoneDisplay}</span></span><strong aria-hidden="true">→</strong></a><a class="modern-contact-tile" href={mapHref} rel="noopener"><span><strong>Open directions</strong><span>{fullAddress}</span></span><strong aria-hidden="true">→</strong></a><a class="modern-contact-tile" href="/modern/forms/"><span><strong>Patient forms</strong><span>Download the fillable medical-history form and privacy notice.</span></span><strong aria-hidden="true">→</strong></a></div></div>
    <div class="modern-form-card"><h2>Request a call</h2><p>Use this demo for general administrative questions only. Nothing entered here is transmitted or stored.</p><form id="modern-inquiry-form" class="modern-form-grid"><div class="modern-field"><label for="inquiry-name">Name</label><input id="inquiry-name" name="name" autocomplete="name" required /></div><div class="modern-field"><label for="inquiry-phone">Phone</label><input id="inquiry-phone" name="phone" autocomplete="tel" inputmode="tel" required /></div><div class="modern-field"><label for="inquiry-email">Email</label><input id="inquiry-email" name="email" type="email" autocomplete="email" /></div><div class="modern-field"><label for="inquiry-preference">Preferred reply</label><select id="inquiry-preference" name="preference"><option>Phone call</option><option>Email</option></select></div><div class="modern-field modern-field--full"><label for="inquiry-topic">General topic</label><select id="inquiry-topic" name="topic"><option>New-patient scheduling</option><option>Existing appointment</option><option>Forms question</option><option>Billing or insurance administration</option><option>Directions or office information</option><option>Other general question</option></select></div><div class="modern-field modern-field--full"><label for="inquiry-message">Administrative message</label><textarea id="inquiry-message" name="message" maxlength="600" required placeholder="Example: I am a new patient and would like a call about appointment availability."></textarea></div><div class="modern-phi-warning"><strong>Do not include protected health information.</strong> Do not enter symptoms, diagnoses, medications, Social Security numbers, insurance IDs, medical history, or treatment details.</div><label class="modern-consent"><input name="safe" type="checkbox" required /> <span>I understand this is a design-preview form for general administrative questions and is not a secure patient portal.</span></label><div class="modern-form-actions"><button class="modern-button modern-button--coral" type="submit">Preview request</button><button class="modern-button modern-button--secondary" type="reset">Clear</button></div></form><div id="modern-inquiry-result" class="modern-inquiry-result" role="status" hidden><strong>Preview complete - nothing was sent</strong><pre id="modern-inquiry-summary"></pre><button id="modern-copy-inquiry" class="modern-button modern-button--secondary" type="button">Copy preview</button></div><p class="modern-form-note">A production version would require an office-approved recipient, spam protection, a retention decision, and confirmation that the workflow remains administrative and non-clinical.</p></div>
  </div></section>
  <section class="modern-section modern-section--sand"><div class="modern-shell modern-visit-grid"><article class="modern-visit-card"><h3>Office hours</h3><table class="modern-hours"><tbody>{site.hours.map((item) => <tr><th scope="row">{item.day}</th><td>{item.hours}</td></tr>)}</tbody></table></article><aside class="modern-visit-card"><h3>Text messaging</h3><p>Texting can be added after the practice confirms a text-capable number, patient expectations, staffing coverage, and the appropriate retention and privacy controls.</p></aside></div></section>
  <script is:inline>
    const form = document.querySelector('#modern-inquiry-form');
    const result = document.querySelector('#modern-inquiry-result');
    const summary = document.querySelector('#modern-inquiry-summary');
    const copy = document.querySelector('#modern-copy-inquiry');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      summary.textContent = [`Name: ${data.get('name') || ''}`, `Phone: ${data.get('phone') || ''}`, `Email: ${data.get('email') || 'Not provided'}`, `Preferred reply: ${data.get('preference') || ''}`, `Topic: ${data.get('topic') || ''}`, '', `${data.get('message') || ''}`].join('\n');
      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    form?.addEventListener('reset', () => { result.hidden = true; summary.textContent = ''; });
    copy?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(summary.textContent || ''); copy.textContent = 'Copied'; window.setTimeout(() => { copy.textContent = 'Copy preview'; }, 1600); } catch { copy.textContent = 'Select and copy the preview'; } });
  </script>
</ModernLayout>
