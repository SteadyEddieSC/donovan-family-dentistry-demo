---
import site from '../data/site.json';
import '../styles/modern.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Modern Lowcountry Concept | Donovan Family Dentistry',
  description = 'A modern design concept for Donovan Family Dentistry on Lady’s Island in Beaufort, South Carolina.'
} = Astro.props;
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.postalCode}`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#062f35" />
  </head>
  <body class="modern-body">
    <a class="modern-skip" href="#modern-main">Skip to main content</a>
    <div class="concept-ribbon">
      <div class="modern-shell concept-ribbon__inner">
        <strong>Concept B</strong>
        <span>Modern Lowcountry direction - sample team content and inquiry workflow</span>
        <a href="/">View the classic concept</a>
      </div>
    </div>
    <header class="modern-header">
      <div class="modern-shell modern-header__inner">
        <a class="modern-brand" href="/modern/" aria-label="Donovan Family Dentistry modern concept home">
          <img src={site.logo} width="320" height="80" alt={site.logoAlt} />
        </a>
        <nav class="modern-nav" aria-label="Modern concept navigation">
          <a href="#care">Care</a>
          <a href="#team">Team</a>
          <a href="#visit">Visit</a>
          <a href="#connect">Connect</a>
        </nav>
        <a class="modern-call" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay}</a>
      </div>
    </header>
    <main id="modern-main"><slot /></main>
    <footer class="modern-footer">
      <div class="modern-shell modern-footer__grid">
        <div>
          <img class="modern-footer__logo" src={site.logo} width="300" height="75" alt={site.logoAlt} />
          <p>Modern concept for a welcoming Lady's Island dental practice rooted in Beaufort and the Lowcountry.</p>
        </div>
        <div>
          <h2>Visit</h2>
          <p><a href={mapHref} rel="noopener">{fullAddress}</a></p>
          <p><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></p>
        </div>
        <div>
          <h2>Office hours</h2>
          <p>Monday-Thursday<br />7:30 AM-5:00 PM</p>
          <p>Friday-Sunday: Closed</p>
        </div>
      </div>
      <div class="modern-shell modern-footer__bottom">
        <span>Concept content must be reviewed and approved before production.</span>
        <a href="/">Classic concept</a>
      </div>
    </footer>
    <nav class="modern-mobile-dock" aria-label="Quick actions">
      <a href={`tel:${site.phoneHref}`}>Call</a>
      <a href={mapHref} rel="noopener">Directions</a>
      <a href="/forms/">Forms</a>
    </nav>
  </body>
</html>
