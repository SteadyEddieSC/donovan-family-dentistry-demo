---
import site from '../data/site.json';
interface Props { fullAddress: string; }
const { fullAddress } = Astro.props;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const openDays = site.hours.filter((item) => item.hours !== 'Closed');
const closedDays = site.hours.filter((item) => item.hours === 'Closed');
const formatDayRange = (items: typeof site.hours) => {
  if (items.length === 0) return '';
  if (items.length === 1) return items[0].day;
  return `${items[0].day}–${items[items.length - 1].day}`;
};
const openDayRange = formatDayRange(openDays);
const closedDayRange = formatDayRange(closedDays);
const openHours = openDays[0]?.hours ?? '';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <section>
        <div class="footer-brand-card"><img src={site.logo} width="300" height="81" alt={site.logoAlt} /></div>
        <h2>{site.practiceName}</h2>
        <p>Family dental care in Beaufort, South Carolina.</p>
        <p><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a><br /><a href={mapHref} rel="noopener">{fullAddress}</a></p>
      </section>
      <section>
        <h3>Explore</h3>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/services/">Services</a>
          <a href="/forms/">Patient Forms</a>
          <a href="/contact/">Contact & Directions</a>
          <a href="/accessibility/">Accessibility</a>
          <a href="/website-use/">Website use & privacy</a>
        </nav>
      </section>
      <section>
        <h3>Office hours</h3>
        <p>{openDayRange}<br />{openHours}</p>
        <p>{closedDayRange}<br />Closed</p>
      </section>
    </div>
    <div class="footer-bottom">© {new Date().getFullYear()} {site.practiceName}. {site.previewMode ? 'Private production-candidate demonstration.' : 'All rights reserved.'}</div>
  </div>
</footer>
