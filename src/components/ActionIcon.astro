---
interface Props {
  name: 'contact' | 'phone' | 'directions' | 'forms';
}

const { name } = Astro.props;
---
<span class="modern-action-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {name === 'contact' && <>
      <rect x="3" y="4.5" width="18" height="15" rx="2.25" />
      <circle cx="8.25" cy="10" r="2.1" />
      <path d="M5.4 16c.8-2 2-3 3.7-3 1.55 0 2.75 1 3.5 3" />
      <path d="M14.5 9h3.7M14.5 12.4h3.7M14.5 15.8h2.5" />
    </>}
    {name === 'phone' && <path d="M7.2 3.8 9.5 8l-2.1 1.55a13.1 13.1 0 0 0 7.05 7.05L16 14.5l4.2 2.3-.55 3.05a2 2 0 0 1-2 1.65C9.3 21.5 2.5 14.7 2.5 6.35a2 2 0 0 1 1.65-2Z" />}
    {name === 'directions' && <>
      <path d="M12 21s6-5.05 6-11a6 6 0 1 0-12 0c0 5.95 6 11 6 11Z" />
      <circle cx="12" cy="10" r="2.2" />
    </>}
    {name === 'forms' && <>
      <path d="M6 3.5h8l4 4v13H6z" />
      <path d="M14 3.5v4h4M9 12h6M9 15.5h6" />
    </>}
  </svg>
</span>
